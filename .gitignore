<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Neon Slicer</title>
    <style>
        :root {
            --neon-blue: #00f2ff;
            --neon-pink: #ff007f;
            --neon-green: #39ff14;
            --neon-red: #ff3131;
            --neon-gold: #ffea00;
            --bg-dark: #0a0a0c;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--bg-dark);
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            color: white;
            user-select: none;
            touch-action: none;
        }

        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        canvas {
            display: block;
            background: radial-gradient(circle at center, #1a1a2e 0%, #0a0a0c 100%);
        }

        #ui-layer {
            position: absolute;
            top: 20px;
            left: 0;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
            padding: 0 30px;
            box-sizing: border-box;
            pointer-events: none;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: bold;
        }

        .stats-top {
            width: 100%;
            display: flex;
            justify-content: space-between;
        }

        .stat-box {
            background: rgba(255, 255, 255, 0.05);
            padding: 10px 20px;
            border-radius: 8px;
            border: 1px solid rgba(0, 242, 255, 0.3);
            backdrop-filter: blur(5px);
            min-width: 120px;
            text-align: center;
        }

        #health-container {
            width: 300px;
            height: 20px;
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid var(--neon-blue);
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 15px rgba(0, 242, 255, 0.2);
        }

        #health-bar {
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, var(--neon-blue), #00a8ff);
            transition: width 0.3s ease-out;
            box-shadow: 0 0 20px var(--neon-blue);
        }

        #score-label { color: var(--neon-blue); text-shadow: 0 0 10px var(--neon-blue); }
        #missed-label { color: var(--neon-pink); text-shadow: 0 0 10px var(--neon-pink); }
        #high-score-display { font-size: 0.8rem; color: var(--neon-gold); opacity: 0.8; margin-top: 5px; }

        #level-up-toast {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 3rem;
            color: var(--neon-gold);
            text-shadow: 0 0 20px var(--neon-gold);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.5s, transform 0.5s;
            z-index: 20;
        }

        #overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
        }

        h1 {
            font-size: 3.5rem;
            margin: 0;
            color: var(--neon-green);
            text-shadow: 0 0 20px var(--neon-green);
            margin-bottom: 10px;
        }

        #new-best-tag {
            color: var(--neon-gold);
            font-size: 1.2rem;
            margin-bottom: 10px;
            animation: pulse 1s infinite alternate;
        }

        p {
            font-size: 1.1rem;
            color: #ccc;
            margin-bottom: 30px;
            text-align: center;
            max-width: 80%;
        }

        .btn {
            background: transparent;
            color: white;
            border: 2px solid var(--neon-green);
            padding: 15px 40px;
            font-size: 1.5rem;
            cursor: pointer;
            border-radius: 50px;
            transition: all 0.2s;
            text-transform: uppercase;
            letter-spacing: 4px;
            pointer-events: auto;
        }

        .btn:hover {
            background: var(--neon-green);
            color: black;
            box-shadow: 0 0 30px var(--neon-green);
        }

        .hidden { display: none !important; }
        
        .damage-flash {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 49, 49, 0.3);
            pointer-events: none;
            opacity: 0;
            z-index: 5;
        }

        .heal-flash {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 234, 0, 0.2);
            pointer-events: none;
            opacity: 0;
            z-index: 5;
        }

        @keyframes flash {
            0% { opacity: 1; }
            100% { opacity: 0; }
        }

        @keyframes pulse {
            0% { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(1.1); opacity: 1; }
        }
    </style>
</head>
<body>

    <div id="game-container">
        <div id="damage-overlay" class="damage-flash"></div>
        <div id="heal-overlay" class="heal-flash"></div>
        <div id="level-up-toast">LEVEL UP!</div>

        <div id="ui-layer">
            <div class="stats-top">
                <div class="stat-box" id="score-label">
                    Score: <span id="score-val">0</span>
                    <div id="high-score-display">Best: <span id="high-score-val">0</span></div>
                </div>
                <div class="stat-box" id="missed-label">Missed: <span id="missed-val">0</span>/15</div>
            </div>
            <div id="health-container">
                <div id="health-bar"></div>
            </div>
        </div>

        <div id="overlay">
            <h1 id="overlay-title">NEON SLICER</h1>
            <div id="new-best-tag" class="hidden">NEW HIGH SCORE!</div>
            <p id="overlay-desc">Catch the slow neon squares! <br>Don't miss more than 15 or let health hit 0!</p>
            <button class="btn" id="start-btn">Begin Session</button>
        </div>

        <canvas id="gameCanvas"></canvas>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreVal = document.getElementById('score-val');
        const missedVal = document.getElementById('missed-val');
        const highScoreVal = document.getElementById('high-score-val');
        const healthBar = document.getElementById('health-bar');
        const damageOverlay = document.getElementById('damage-overlay');
        const healOverlay = document.getElementById('heal-overlay');
        const overlay = document.getElementById('overlay');
        const overlayTitle = document.getElementById('overlay-title');
        const startBtn = document.getElementById('start-btn');
        const newBestTag = document.getElementById('new-best-tag');
        const levelUpToast = document.getElementById('level-up-toast');

        let gameActive = false;
        let score = 0;
        let highScore = 0;
        let missedCount = 0;
        let health = 100;
        let fruits = [];
        let particles = [];
        let sliceTrail = [];
        
        // Difficulty scaling variables
        let difficultyLevel = 1;
        let currentTargetOnScreen = 3;
        let speedMultiplier = 1.0;
        let gravityBase = 0.07;

        let mouseX = 0;
        let mouseY = 0;
        let smoothedX = 0;
        let smoothedY = 0;
        const sensitivity = 0.2; 

        const MAX_MISSED = 15;

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            mouseX = canvas.width / 2;
            mouseY = canvas.height / 2;
            smoothedX = mouseX;
            smoothedY = mouseY;
        }
        window.addEventListener('resize', resize);
        resize();

        // Load high score from memory (simulated)
        if (localStorage.getItem('neonSlicerHighScore')) {
            highScore = parseInt(localStorage.getItem('neonSlicerHighScore'));
            highScoreVal.innerText = highScore;
        }

        const updateInput = (e) => {
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            mouseX = clientX;
            mouseY = clientY;
        };

        window.addEventListener('mousemove', updateInput);
        window.addEventListener('touchstart', (e) => {
             updateInput(e);
             smoothedX = mouseX;
             smoothedY = mouseY;
        });
        window.addEventListener('touchmove', (e) => {
            e.preventDefault();
            updateInput(e);
        }, { passive: false });

        class Fruit {
            constructor(type = "normal") {
                this.type = type; 
                this.size = Math.random() * 15 + 45; 
                if (this.type === "mega") this.size = 85; 
                this.reset();
            }

            reset() {
                this.x = Math.random() * (canvas.width - 200) + 100;
                this.y = canvas.height + 100;
                this.vx = (Math.random() - 0.5) * 2 * speedMultiplier; 
                this.vy = -(Math.random() * 2 + 6.5) * speedMultiplier; 
                this.gravity = gravityBase * speedMultiplier; 
                
                if (this.type === "hazard") {
                    this.color = '#ff3131'; 
                } else if (this.type === "mega") {
                    this.color = '#ffea00'; 
                } else {
                    this.color = `hsl(${Math.random() * 360}, 100%, 70%)`;
                }
                
                this.isSliced = false;
                this.rotation = Math.random() * Math.PI * 2;
                this.rotSpeed = (Math.random() - 0.5) * 0.04 * speedMultiplier;
            }

            update() {
                this.vy += this.gravity;
                this.x += this.vx;
                this.y += this.vy;
                this.rotation += this.rotSpeed;

                if (this.y > canvas.height + 150 && !this.isSliced) {
                    if (this.type === "normal") {
                        missedCount++;
                        missedVal.innerText = missedCount;
                        if (missedCount >= MAX_MISSED) gameOver("SYSTEM OVERLOAD");
                    }
                    return false;
                }
                return true;
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.rotation);
                
                if (this.type === "hazard") {
                    const flicker = Math.random() > 0.1 ? 20 : 5;
                    ctx.shadowBlur = flicker;
                    ctx.shadowColor = this.color;
                    ctx.strokeStyle = this.color;
                    ctx.lineWidth = 5;
                    ctx.strokeRect(-this.size/2, -this.size/2, this.size, this.size);
                    
                    ctx.beginPath();
                    ctx.moveTo(-this.size/4, -this.size/4);
                    ctx.lineTo(this.size/4, this.size/4);
                    ctx.moveTo(this.size/4, -this.size/4);
                    ctx.lineTo(-this.size/4, this.size/4);
                    ctx.stroke();
                } else if (this.type === "mega") {
                    ctx.shadowBlur = 25;
                    ctx.shadowColor = this.color;
                    ctx.strokeStyle = this.color;
                    ctx.lineWidth = 8;
                    ctx.strokeRect(-this.size/2, -this.size/2, this.size, this.size);
                    ctx.lineWidth = 2;
                    ctx.strokeRect(-this.size/3, -this.size/3, (this.size/3)*2, (this.size/3)*2);
                } else {
                    ctx.shadowBlur = 10;
                    ctx.shadowColor = this.color;
                    ctx.strokeStyle = this.color;
                    ctx.lineWidth = 4;
                    ctx.strokeRect(-this.size/2, -this.size/2, this.size, this.size);
                }
                
                ctx.restore();
            }
        }

        class Particle {
            constructor(x, y, color) {
                this.x = x;
                this.y = y;
                this.color = color;
                this.vx = (Math.random() - 0.5) * 8;
                this.vy = (Math.random() - 0.5) * 8;
                this.life = 1.0;
                this.size = Math.random() * 4 + 2;
            }
            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.life -= 0.02;
            }
            draw() {
                ctx.globalAlpha = this.life;
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.globalAlpha = 1;
            }
        }

        function triggerDamage() {
            health -= 30;
            if (health < 0) health = 0;
            updateHealthUI();
            
            damageOverlay.style.animation = 'none';
            damageOverlay.offsetHeight; 
            damageOverlay.style.animation = 'flash 0.4s forwards';

            if (health <= 0) {
                gameOver("CRITICAL FAILURE");
            }
        }

        function triggerHeal() {
            health += 20;
            if (health > 100) health = 100;
            updateHealthUI();
            
            healOverlay.style.animation = 'none';
            healOverlay.offsetHeight; 
            healOverlay.style.animation = 'flash 0.4s forwards';
        }

        function updateHealthUI() {
            healthBar.style.width = health + '%';
            if (health < 30) {
                healthBar.style.background = 'var(--neon-red)';
            } else {
                healthBar.style.background = 'linear-gradient(90deg, var(--neon-blue), #00a8ff)';
            }
        }

        function checkLevelUp() {
            // Level up every 1000 points
            const newLevel = Math.floor(score / 1000) + 1;
            if (newLevel > difficultyLevel) {
                difficultyLevel = newLevel;
                speedMultiplier += 0.15;
                currentTargetOnScreen = Math.min(3 + Math.floor(difficultyLevel / 2), 7);
                
                // Show toast
                levelUpToast.style.opacity = '1';
                levelUpToast.style.transform = 'translate(-50%, -80%)';
                setTimeout(() => {
                    levelUpToast.style.opacity = '0';
                    levelUpToast.style.transform = 'translate(-50%, -50%)';
                }, 1500);
            }
        }

        function checkSlices(sx, sy) {
            fruits.forEach(fruit => {
                if (!fruit.isSliced) {
                    const dx = sx - fruit.x;
                    const dy = sy - fruit.y;
                    const dist = Math.sqrt(dx*dx + dy*dy);
                    
                    if (dist < fruit.size * 0.95) {
                        fruit.isSliced = true;
                        if (fruit.type === "hazard") {
                            triggerDamage();
                            for(let i=0; i<30; i++) {
                                particles.push(new Particle(fruit.x, fruit.y, '#ff3131'));
                            }
                        } else if (fruit.type === "mega") {
                            triggerHeal();
                            score += 250;
                            for(let i=0; i<40; i++) {
                                particles.push(new Particle(fruit.x, fruit.y, '#ffea00'));
                            }
                        } else {
                            score += 50;
                            for(let i=0; i<8; i++) {
                                particles.push(new Particle(fruit.x, fruit.y, fruit.color));
                            }
                        }
                        scoreVal.innerText = score;
                        checkLevelUp();
                    }
                }
            });
        }

        function spawnFruit() {
            if (fruits.length < currentTargetOnScreen) {
                if (Math.random() < (0.015 + (difficultyLevel * 0.005))) {
                    const rand = Math.random();
                    let type = "normal";
                    
                    if (rand < 0.05) { 
                        type = "mega";
                    } else if (rand < 0.12) { 
                        type = "hazard";
                    }
                    
                    fruits.push(new Fruit(type));
                }
            }
        }

        function initGame() {
            score = 0;
            missedCount = 0;
            health = 100;
            difficultyLevel = 1;
            speedMultiplier = 1.0;
            currentTargetOnScreen = 3;
            fruits = [];
            particles = [];
            sliceTrail = [];
            scoreVal.innerText = "0";
            missedVal.innerText = "0";
            updateHealthUI();
            gameActive = true;
            overlay.classList.add('hidden');
            newBestTag.classList.add('hidden');
            requestAnimationFrame(gameLoop);
        }

        function gameOver(message = "SESSION ENDED") {
            gameActive = false;
            overlay.classList.remove('hidden');
            overlayTitle.innerText = message;
            overlayTitle.style.color = "var(--neon-pink)";
            overlayTitle.style.textShadow = "0 0 20px var(--neon-pink)";
            startBtn.innerText = "Retry Protocol";

            if (score > highScore) {
                highScore = score;
                highScoreVal.innerText = highScore;
                localStorage.setItem('neonSlicerHighScore', highScore);
                newBestTag.classList.remove('hidden');
            }
        }

        function gameLoop() {
            if (!gameActive && particles.length === 0) return;

            ctx.fillStyle = 'rgba(10, 10, 12, 0.4)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            if (gameActive) {
                smoothedX += (mouseX - smoothedX) * sensitivity;
                smoothedY += (mouseY - smoothedY) * sensitivity;

                sliceTrail.push({ x: smoothedX, y: smoothedY, time: Date.now() });
                checkSlices(smoothedX, smoothedY);

                const now = Date.now();
                sliceTrail = sliceTrail.filter(p => now - p.time < 120);
                
                if (sliceTrail.length > 1) {
                    ctx.beginPath();
                    ctx.strokeStyle = 'rgba(255, 255, 255, 0.8)';
                    ctx.lineWidth = 3;
                    ctx.lineCap = 'round';
                    ctx.moveTo(sliceTrail[0].x, sliceTrail[0].y);
                    for(let i=1; i < sliceTrail.length; i++) {
                        ctx.lineTo(sliceTrail[i].x, sliceTrail[i].y);
                    }
                    ctx.stroke();
                }

                spawnFruit();
                fruits = fruits.filter(f => {
                    const alive = f.update();
                    if (alive && !f.isSliced) f.draw();
                    return alive && !f.isSliced;
                });
            }

            for (let i = particles.length - 1; i >= 0; i--) {
                particles[i].update();
                particles[i].draw();
                if (particles[i].life <= 0) particles.splice(i, 1);
            }

            requestAnimationFrame(gameLoop);
        }

        startBtn.addEventListener('click', initGame);
    </script>
</body>
</html>
